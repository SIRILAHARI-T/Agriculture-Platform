# MongoDB connection string (local Community Server)
MONGO_URI=mongodb://127.0.0.1:27017/AgriPlatform

# JWT configuration
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Optional: Government open-data API key (used by market/weather features)
DATA_GOV_API_KEY=your_api_key_here

# Optional: explicitly set port (default: 5000)
# PORT=5000

# Set to "production" to suppress stack traces in error responses
# NODE_ENV=development

